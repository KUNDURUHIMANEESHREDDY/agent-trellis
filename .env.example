PORT=8787
RELATE_DB_PATH=./.data/agent-trellis
# Required for the MCP runtime gateway and trusted adapters posting runtime events; use a unique random secret.
AGENT_TRELLIS_RUNTIME_TOKEN=replace-with-a-random-secret
# Continuous read-only inspection interval; 0 disables the scheduler (manual API scans remain available).
AGENT_TRELLIS_MONITOR_INTERVAL_MS=300000
# Local stdio processes are not launched automatically unless this is explicitly enabled.
AGENT_TRELLIS_MONITOR_STDIO=false

# Separate token for the local stdio sidecar to report gateway-observed lifecycle events.
AGENT_TRELLIS_RUNTIME_GATEWAY_TOKEN=replace-with-a-second-random-secret
# Separate token for the host filesystem watcher to report OS-observed changes.
AGENT_TRELLIS_RUNTIME_OBSERVER_TOKEN=replace-with-a-third-random-secret
# Opt in before launching any discovered stdio MCP server through the sidecar.
AGENT_TRELLIS_RUNTIME_STDIO=false
# Independently watch filesystem changes around a locally launched stdio server.
AGENT_TRELLIS_RUNTIME_OBSERVE_FILESYSTEM=false
# Optional additional watch roots, separated by the OS path delimiter; the server cwd is always watched.
AGENT_TRELLIS_RUNTIME_WATCH_PATHS=
# API endpoint used by the stdio sidecar; defaults to loopback PORT.
AGENT_TRELLIS_API_URL=http://127.0.0.1:8787
